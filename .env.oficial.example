# =====================================================================
#  REYES GESTIÓN — BASE OFICIAL (Supabase)  ·  PLANTILLA
#  Copia este archivo como `.env.oficial` (NO se sube a git).
#  Estas variables reemplazan a las de .env.local cuando usas los
#  comandos "oficial:" (pnpm oficial:app, oficial:migrar, oficial:respaldo…).
# =====================================================================

APP_ENTORNO=oficial

# Conexión: Supabase → proyecto reyes-gestion → botón "Connect" → "Session pooler".
# Copia la URI completa y reemplaza [YOUR-PASSWORD] por la contraseña de la base.
# Debe terminar en ?sslmode=require
DATABASE_URL=PEGAR_AQUI_LA_URI_DEL_SESSION_POOLER

# Session pooler (puerto 5432) admite sentencias preparadas. Si algún día usas el
# Transaction pooler (puerto 6543, para hosting serverless) cambia esto a false.
DATABASE_PREPARE=true
# El plan gratuito de Supabase permite pocas conexiones: la app usa como máximo 5.
DATABASE_MAX_CONEXIONES=5

# Archivos subidos de la base oficial (separados de los de prueba)
STORAGE_DIR=./storage-oficial
