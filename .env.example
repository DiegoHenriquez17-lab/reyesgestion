# =====================================================================
#  REYES GESTIÓN — Variables de entorno (PLANTILLA)
#  Copia este archivo como `.env.local` y completa los valores.
#  `.env.local` NUNCA se sube a git (contiene contraseñas y claves).
# =====================================================================

# --- Base de datos PostgreSQL ---------------------------------------
# Datos del contenedor Docker de desarrollo (docker-compose.yml los usa)
DB_USER=reyes_app
DB_PASSWORD=CAMBIAR_CONTRASENA
DB_NAME=reyes_gestion
DB_PORT=5433
# Formato: postgres://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE
DATABASE_URL=postgres://${DB_USER}:${DB_PASSWORD}@localhost:${DB_PORT}/${DB_NAME}

# --- Aplicación -----------------------------------------------------
# Zona horaria usada para fechas de vencimiento, alertas y cierres.
APP_TIMEZONE=America/Santiago
# Duración de la sesión de usuario (días).
SESSION_DIAS=30
# Carpeta donde se guardan los archivos subidos (vouchers, PDF, fotos…).
# Ruta relativa a la raíz del proyecto o absoluta.
STORAGE_DIR=./storage
# Tamaño máximo por archivo subido (MB).
UPLOAD_MAX_MB=20

# --- Inteligencia artificial (lectura de fotos, PDF, Word) ----------
# Clave de la API de Anthropic (https://console.anthropic.com).
# Si se deja vacía, la carga por IA queda desactivada (Excel sigue funcionando).
ANTHROPIC_API_KEY=
# Modelo de Claude usado para extraer información.
AI_MODEL=claude-opus-5-5
# Profundidad de análisis: low | medium | high
AI_EFFORT=medium

# --- Usuario administrador inicial (solo para `pnpm db:seed`) -------
# Si se completan, el seed crea este usuario cuando no existe ninguno.
# También puedes crear el primer usuario desde la pantalla /primer-usuario.
SEED_ADMIN_NOMBRE=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
