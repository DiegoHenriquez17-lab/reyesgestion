{
  "name": "reyes-gestion",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:docker": "docker compose --env-file .env.local up -d --wait",
    "db:docker:parar": "docker compose --env-file .env.local stop",
    "db:crear-nativa": "powershell -ExecutionPolicy Bypass -File scripts/db/crear-base-local.ps1",
    "db:generar": "drizzle-kit generate",
    "db:migrar": "drizzle-kit migrate && tsx --conditions=react-server scripts/db/asegurar-rls.ts",
    "db:seed": "tsx --conditions=react-server scripts/db/seed.ts",
    "db:demo": "tsx --conditions=react-server scripts/db/demo.ts",
    "db:studio": "drizzle-kit studio",
    "db:respaldo": "powershell -ExecutionPolicy Bypass -File scripts/db/respaldo.ps1",
    "alertas": "tsx --conditions=react-server scripts/alertas.ts",
    "oficial:app": "node scripts/oficial-app.mjs",
    "oficial:migrar": "drizzle-kit migrate --config drizzle.oficial.config.ts && tsx --env-file=.env.oficial --conditions=react-server scripts/db/asegurar-rls.ts",
    "oficial:seed": "tsx --env-file=.env.oficial --conditions=react-server scripts/db/seed.ts",
    "oficial:respaldo": "powershell -ExecutionPolicy Bypass -File scripts/db/respaldo.ps1 -Archivo .env.oficial",
    "oficial:alertas": "tsx --env-file=.env.oficial --conditions=react-server scripts/alertas.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@node-rs/argon2": "^2.2.2",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.4",
    "exceljs": "^4.4.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^1.70.0",
    "mammoth": "^1.13.0",
    "next": "16.4.5",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@next/env": "16.4.5",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@9.12.0"
}
